{
  "name": "muse-canvas",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --if-present --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:tokens": "node scripts/check-web-tokens.mjs",
    "test": "pnpm -r --if-present test",
    "test:e2e:admin": "node tests/e2e/admin-panel.mjs",
    "prepare:prompt-templates": "node scripts/prepare-prompt-templates.mjs",
    "compose:up": "node scripts/generate-env.mjs && docker compose --project-directory . --env-file .env -f deploy/compose.yaml up --build -d",
    "compose:down": "docker compose --project-directory . --env-file .env -f deploy/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
