# ──────────────────────────────────────────────────────────────
# MuseCanvas environment template
# Copy to .env and fill in. NEVER commit real secrets.
#
# `pnpm compose:up` generates the bootstrap keys below automatically and
# appends any missing ones to an existing .env on upgrade (existing values
# are never changed).
# ──────────────────────────────────────────────────────────────

# ===== Bootstrap (required) — api/worker/db-migrate fail fast without these =====
# Postgres superuser password for the Compose-managed database.
POSTGRES_PASSWORD=
# Application master key: exactly 32 bytes, as 64 hex chars or
# base64/base64url. All credentials stored via onboarding are encrypted
# under keys derived from it. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=
# Local non-Compose runs only (Compose builds these URLs internally):
# DATABASE_URL=postgresql://musecanvas:change-me@localhost:5432/musecanvas
# REDIS_URL=redis://localhost:6379
# NODE_ENV=development

# ===== Deployment-only infrastructure =====
# Credentials for the bundled local MinIO (compose.yaml / compose.dev.yaml only).
MINIO_ROOT_USER=musecanvas
MINIO_ROOT_PASSWORD=
# Local MinIO only: allowed browser origins for direct presigned POST upload (comma-separated or *)
# MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Image deployment knobs (compose.images.yaml / compose.prod.yaml web build):
# MUSECANVAS_IMAGE_TAG=latest
# MUSECANVAS_HTTP_PORT=18080
# Optional: base URL the web app calls for the backend API (same-origin default).
# VITE_API_BASE_URL=
# Source/image deployment stacks expect TLS and default cookies to Secure.
# Set false only when intentionally exposing Nginx directly over plain HTTP.
# Bundled local stacks default this to false for their documented HTTP ports.
# COOKIE_SECURE=true

# ===== Deployment security policies (default-deny; keep false unless required) =====
# Plaintext SMTP is only ever needed for the bundled Mailpit, which the
# bundled Compose files already allow. External deployments must use
# encrypted SMTP and leave this false.
ALLOW_INSECURE_SMTP=false
# Local/private provider endpoints are rejected unless explicitly enabled.
ALLOW_INSECURE_PROVIDER_BASE_URL=false
ALLOW_PRIVATE_PROVIDER_BASE_URL=false

# ===== Upgrade-only legacy crypto (optional, one release) =====
# Read-only fallback for rows encrypted before the APP_MASTER_KEY rollout:
# existing sessions/OTP (SESSION_SECRET), OAuth client secrets
# (OAUTH_CREDENTIALS_ENCRYPTION_KEY), and provider credentials
# (PROVIDER_CREDENTIALS_ENCRYPTION_KEY). All new writes use keys derived
# from APP_MASTER_KEY. Leave unset on fresh installs; remove after upgrading
# past this release.
# SESSION_SECRET=
# OAUTH_CREDENTIALS_ENCRYPTION_KEY=
# PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# ===== Onboarding-managed (do NOT set as env) =====
# SMTP, application S3 config, public origin/site URL, OAuth client
# credentials, upload limits, and prompt templates are database settings
# configured and tested via the onboarding wizard at /setup. Setting them
# as environment variables has no effect.
