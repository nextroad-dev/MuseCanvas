# ──────────────────────────────────────────────────────────────
# MuseCanvas environment template
# Copy to .env and fill in. NEVER commit real secrets.
#
# `pnpm compose:up` generates the bootstrap keys below automatically and
# appends any missing ones to an existing .env on upgrade (existing values
# are never changed).
# ──────────────────────────────────────────────────────────────

# ===== Bootstrap (required) — api/worker/db-migrate fail fast without these =====
# Postgres superuser password for the Compose-managed database.
POSTGRES_PASSWORD=
# Application master key: exactly 32 bytes, as 64 hex chars or
# base64/base64url. All credentials stored via onboarding are encrypted
# under keys derived from it. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=
# Local non-Compose runs only (Compose builds these URLs internally):
# DATABASE_URL=postgresql://musecanvas:change-me@localhost:5432/musecanvas
# REDIS_URL=redis://localhost:6379
# NODE_ENV=development

# ===== Deployment-only infrastructure =====
# Credentials for the bundled local MinIO (compose.yaml / compose.dev.yaml only).
MINIO_ROOT_USER=musecanvas
MINIO_ROOT_PASSWORD=
# Local MinIO only: allowed browser origins for direct presigned POST upload (comma-separated or *)
# MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Image deployment knobs (compose.images.yaml / compose.prod.yaml web build):
# MUSECANVAS_IMAGE_TAG=latest
# MUSECANVAS_HTTP_PORT=18080

# First-run onboarding (/setup) needs a one-time claim code. In production nothing is minted
# unless you opt in. Set ONE of these for the first install only, then remove it:
#   SETUP_CLAIM_DELIVERY=log   prints the code once to the API container log
#                              (docker compose logs api | grep "MUSECANVAS SETUP CLAIM").
#                              Anyone who can read that log can redeem the code for 15 minutes
#                              (single use, 5 attempts), so clear the log line after use.
#   SETUP_CLAIM_DELIVERY=file  writes the code (mode 0600) to SETUP_CLAIM_FILE, a path inside
#                              the API container; read it with docker compose exec.
# SETUP_CLAIM_DELIVERY=
# SETUP_CLAIM_FILE=
# Leave SETUP_CLAIM_REQUIRED unset (the default) in every normal install: /setup then needs the claim code.
# SETUP_CLAIM_REQUIRED=false removes the claim code. WARNING: while no admin exists, anyone who can reach
# /setup can configure SMTP and create the first admin. Use it only on networks you control, and remove
# it once the first admin exists. The window closes by itself after that, but leave it unset elsewhere.
# SETUP_CLAIM_REQUIRED=
# Local web dev only (apps/web/.env.local): point the dev rewrites
# proxy directly at the API so write requests keep a valid X-Forwarded-Host.
# API_ORIGIN=http://localhost:3001
# In containers web SSR talks to the API directly via INTERNAL_API_BASE_URL
# (set by compose); browsers always use the same-origin /api proxied by Nginx.
# Source/image deployment stacks expect TLS and default cookies to Secure.
# Set false only when intentionally exposing Nginx directly over plain HTTP.
# Bundled local stacks default this to false for their documented HTTP ports.
# COOKIE_SECURE=true

# ===== Backend resource budgets (per process; pool totals scale with replicas) =====
DATABASE_POOL_MAX=12
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=1000
WORKER_REDIS_COMMAND_TIMEOUT_MS=5000
WORKER_CONCURRENCY=2
WORKER_STORAGE_TIMEOUT_MS=60000
# Only acknowledged/delivered Stream entries older than this are removed.
# Pending/unread entries and streams with unknown groups are never trimmed.
# Set 0 to disable automatic Stream deletion before deploying if required.
STREAM_RETENTION_SECONDS=604800
STREAM_TRIM_BATCH_SIZE=1000

# ===== Deployment security policies (default-deny; keep false unless required) =====
# Plaintext SMTP is only ever needed for the bundled Mailpit, which the
# bundled Compose files already allow. External deployments must use
# encrypted SMTP and leave this false.
ALLOW_INSECURE_SMTP=false
# Local/private provider endpoints are rejected unless explicitly enabled.
ALLOW_INSECURE_PROVIDER_BASE_URL=false
ALLOW_PRIVATE_PROVIDER_BASE_URL=false
# Admin uploads of provider plugin code packages (POST /api/admin/plugins/upload)
# are denied until explicitly enabled. When enabled, the API validates the .mjs
# artifact and stores it in the configured object storage bucket; the worker then
# pulls it back out and dynamically imports it. Both services need the flag: the
# API to gate the endpoint, the worker to decide whether to refresh at all.
ALLOW_PLUGIN_UPLOAD=false
# Optional override for the worker's local plugin artifact cache directory inside
# its container. Compose already defaults it to /tmp/musecanvas-plugin-cache; it
# must never live under /app (an ephemeral image layer, shared with no other
# service — api and worker run from separate images with no shared volume).
# PLUGIN_CACHE_DIR=/tmp/musecanvas-plugin-cache

# ===== Upgrade-only legacy crypto (optional, one release) =====
# Read-only fallback for rows encrypted before the APP_MASTER_KEY rollout:
# existing sessions/OTP (SESSION_SECRET), OAuth client secrets
# (OAUTH_CREDENTIALS_ENCRYPTION_KEY), and provider credentials
# (PROVIDER_CREDENTIALS_ENCRYPTION_KEY). All new writes use keys derived
# from APP_MASTER_KEY. Leave unset on fresh installs; remove after upgrading
# past this release.
# SESSION_SECRET=
# OAUTH_CREDENTIALS_ENCRYPTION_KEY=
# PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# ===== Onboarding-managed (do NOT set as env) =====
# SMTP, application S3 config, public origin/site URL, OAuth client
# credentials, upload limits, and prompt templates are database settings
# configured and tested via the onboarding wizard at /setup. Setting them
# as environment variables has no effect.
